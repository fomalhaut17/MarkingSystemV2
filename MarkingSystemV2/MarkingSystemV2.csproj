<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MarkingSystemV2</AssemblyName>
    <RootNamespace>MarkingSystemV2</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 단일 exe 배포 옵션 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 버전은 MinVer가 git tag(vX.Y.Z)에서 자동 주입. 태그 없는 빌드는 0.0.0-alpha.0.* 폴백 -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- ===================== 배포 버전 수동 지정 =====================
         git 없이 전달하는 zip 사본에서, 아래 빈 태그에 버전을 채우면
         MinVer가 git을 무시하고 그 버전으로 고정한다.
             예) <MinVerVersionOverride>1.0.0</MinVerVersionOverride>
         ⚠ 원본 repo에서는 반드시 비워둘 것 (비어 있어야 git tag 자동 버전 유지).
         ============================================================== -->
    <MinVerVersionOverride></MinVerVersionOverride>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf"/>
    <Resource Include="Fonts\*.otf"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="5.0.0" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.dev.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.prod.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
