<UserControl x:Class="MarkingSystemV2.Views.MarkingInquiryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,28"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Sv"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource AppBackground}">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Top"
              MinHeight="{Binding ViewportHeight, ElementName=Sv}"
              Margin="32,0,32,0">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="560"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="560"/>
                </Grid.ColumnDefinitions>

                <!-- ═════ 좌측 컬럼 ═════ -->
                <StackPanel Grid.Column="0">

                    <!-- 물류바코드 -->
                    <TextBlock Text="물류바코드" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="BarcodeBox"
                                 Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBox}"
                                 TextAlignment="Right"
                                 TabIndex="1"
                                 KeyDown="BarcodeBox_KeyDown"
                                 GotFocus="BarcodeBox_GotFocus"/>
                        <Button Grid.Column="2"
                                Content="조회"
                                Command="{Binding QueryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                IsTabStop="False"
                                Padding="0"/>
                    </Grid>

                    <!-- 품명 -->
                    <TextBlock Text="품명" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Itemnam, Mode=OneWay}"
                             Height="56"
                             Style="{StaticResource ReadOnlyTextBox}"
                             IsTabStop="False"
                             Margin="0,0,0,28"/>

                    <!-- 제조일자 -->
                    <TextBlock Text="제조일자" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EndIDay, Mode=OneWay}"
                             Height="56"
                             Style="{StaticResource ReadOnlyTextBox}"
                             IsTabStop="False"
                             Margin="0,0,0,28"/>

                    <!-- 용기 내 수량 -->
                    <TextBlock Text="용기 내 수량" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EndICnt, Mode=OneWay}"
                             Height="56"
                             Style="{StaticResource ReadOnlyTextBox}"
                             IsTabStop="False"/>

                </StackPanel>

                <!-- ═════ 우측 컬럼 ═════ -->
                <StackPanel Grid.Column="2">

                    <!-- Lot 코드 -->
                    <TextBlock Text="Lot 코드" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding LotNoHead, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBox}"
                                 IsTabStop="False"/>
                        <Button Grid.Column="2"
                                Content="복사"
                                Command="{Binding CopyLotNoHeadCommand}"
                                Style="{StaticResource GhostButton}"
                                IsTabStop="False"
                                Padding="0"/>
                    </Grid>

                    <!-- 최종 발행 Ser. -->
                    <TextBlock Text="최종 발행 Ser." Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LotMax, Mode=OneWay}"
                             Height="56"
                             Style="{StaticResource ReadOnlyTextBox}"
                             IsTabStop="False"
                             Margin="0,0,0,28"/>

                    <!-- 발행시작번호 -->
                    <TextBlock Text="발행시작번호" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding StartSerial, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBox}"
                                 Foreground="{StaticResource BluePrimary}"
                                 FontWeight="Bold"
                                 IsTabStop="False"/>
                        <Button Grid.Column="2"
                                Content="복사"
                                Command="{Binding CopyStartSerialCommand}"
                                Style="{StaticResource GhostButton}"
                                IsTabStop="False"
                                Padding="0"/>
                    </Grid>

                    <!-- 최종각인번호 -->
                    <TextBlock Text="최종각인번호" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="EndSerialBox"
                                 Style="{StaticResource FluentTextBox}"
                                 Text="{Binding EndSerial, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasResult}"
                                 TextAlignment="Right"
                                 TabIndex="2"
                                 GotFocus="EndSerialBox_GotFocus"
                                 TextChanged="EndSerialBox_TextChanged"/>
                        <Button Grid.Column="2"
                                Content="저장"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsTabStop="False"
                                Padding="0"/>
                    </Grid>

                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
