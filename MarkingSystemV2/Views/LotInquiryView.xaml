<UserControl x:Class="MarkingSystemV2.Views.LotInquiryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 셀 텍스트 공통 -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontFamily"           Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"             Value="12"/>
            <Setter Property="Foreground"           Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment"  Value="Center"/>
            <Setter Property="VerticalAlignment"    Value="Center"/>
            <Setter Property="TextAlignment"        Value="Center"/>
        </Style>

        <!-- 셀 테두리 공통 (우/하 1px) -->
        <Style x:Key="CellBorderBase" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 그룹/항목 라벨 셀 -->
        <Style x:Key="GroupCell" TargetType="Border" BasedOn="{StaticResource CellBorderBase}">
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
        </Style>
        <Style x:Key="LabelCellBorder" TargetType="Border" BasedOn="{StaticResource CellBorderBase}">
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <!-- 헤더 셀 (1차~5차, 표준/측정) -->
        <Style x:Key="HeaderCell" TargetType="Border" BasedOn="{StaticResource CellBorderBase}">
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 표준값 / 측정값 데이터 셀 -->
        <Style x:Key="StdCell" TargetType="Border" BasedOn="{StaticResource CellBorderBase}">
            <Setter Property="Background" Value="#C8E6C9"/>
        </Style>
        <Style x:Key="ValCell" TargetType="Border" BasedOn="{StaticResource CellBorderBase}">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Lot 코드 입력 ── -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Lot 코드"
                       Style="{StaticResource LabelText}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="2"
                     Height="40"
                     Text="{Binding LotNo, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FluentTextBox}"
                     KeyDown="LotNoBox_KeyDown"/>
            <Button Grid.Column="4"
                    Content="Lot 조회"
                    Height="40"
                    Command="{Binding QueryCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="0"/>
        </Grid>

        <!-- ── 메인 콘텐츠 (좌측 정보 + 우측 그리드) ── -->
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌측: 제품정보 + 생산이력 ── -->
            <StackPanel Grid.Column="0">

                <!-- 제품정보 -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2"
                                Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="제품정보"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="12,0"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="차종" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding CarModel}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="품명" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding ItemName}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0" TextWrapping="NoWrap"/>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="품번" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding ItemCode}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0" TextWrapping="NoWrap"/>
                        </Border>

                        <Border Grid.Row="4" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="원재료명" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding MaterialName}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0" TextWrapping="NoWrap"/>
                        </Border>

                        <Border Grid.Row="5" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <TextBlock Text="GRADE" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="1">
                            <TextBlock Text="{Binding Grade}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Height="16"/>

                <!-- 생산이력 -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2"
                                Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="생산이력"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="12,0"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="생산일자" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding ProductionDate}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="사출설비" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding InjectionEquip}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <TextBlock Text="각인일자" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding MarkingDate}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>

                        <Border Grid.Row="4" Grid.Column="0" Background="#F0F0F0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <TextBlock Text="각인설비" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="1">
                            <TextBlock Text="{Binding MarkingEquip}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ── 우측: 사출 조건 그리드 (Grid 셀병합) ── -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <!-- ─── 헤더 행 0~1 ─── -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                            Style="{StaticResource HeaderCell}"/>

                    <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                        <TextBlock Text="1차" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                        <TextBlock Text="2차" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                        <TextBlock Text="3차" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                        <TextBlock Text="4차" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="10" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                        <TextBlock Text="5차" Style="{StaticResource HeaderText}"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderCell}"><TextBlock Text="표준" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderCell}"><TextBlock Text="측정" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource HeaderCell}"><TextBlock Text="표준" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource HeaderCell}"><TextBlock Text="측정" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource HeaderCell}"><TextBlock Text="표준" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="7" Style="{StaticResource HeaderCell}"><TextBlock Text="측정" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="8" Style="{StaticResource HeaderCell}"><TextBlock Text="표준" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="9" Style="{StaticResource HeaderCell}"><TextBlock Text="측정" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="10" Style="{StaticResource HeaderCell}"><TextBlock Text="표준" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="11" Style="{StaticResource HeaderCell}"><TextBlock Text="측정" Style="{StaticResource CellText}"/></Border>

                    <!-- ─── 그룹 라벨 (Col 0, RowSpan) ─── -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.RowSpan="5" Style="{StaticResource GroupCell}">
                        <TextBlock Text="사출조건" Style="{StaticResource CellText}"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource GroupCell}">
                        <TextBlock Text="계량조건" Style="{StaticResource CellText}"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="0" Grid.RowSpan="4" Style="{StaticResource GroupCell}">
                        <TextBlock Text="가스조건" Style="{StaticResource CellText}"/>
                    </Border>
                    <Border Grid.Row="14" Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource GroupCell}">
                        <TextBlock Text="보압" Style="{StaticResource CellText}"/>
                    </Border>
                    <Border Grid.Row="17" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource GroupCell}">
                        <TextBlock Text="HOT RUNNER" Style="{StaticResource CellText}"/>
                    </Border>

                    <!-- 단일 행 그룹 (Col 0~1 병합) -->
                    <Border Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GroupCell}">
                        <TextBlock Text="냉각시간" Style="{StaticResource CellText}"/>
                    </Border>
                    <Border Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GroupCell}">
                        <TextBlock Text="금형보호" Style="{StaticResource CellText}"/>
                    </Border>
                    <Border Grid.Row="21" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GroupCell}">
                        <TextBlock Text="가스위치" Style="{StaticResource CellText}"/>
                    </Border>

                    <!-- ─── 항목명 라벨 (Col 1) ─── -->
                    <Border Grid.Row="2"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="온도(°C)"      Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"/>
                    <Border Grid.Row="4"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="압력(kg/cm²)"  Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="5"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="속도(%)"       Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="6"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="시간"          Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="7"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="압력(kg/cm²)"  Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="8"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="속도(%)"       Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="9"  Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="위치(mm)"      Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="10" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="딜레이(초)"    Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="11" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="시간(초)"      Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="12" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="압력(kg/cm²)"  Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="13" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="위치(mm)"      Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="14" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="압력(kg/cm²)"  Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="15" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="속도(%)"       Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="16" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="시간(초)"      Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="17" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="A"             Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="18" Grid.Column="1" Style="{StaticResource LabelCellBorder}"><TextBlock Text="B"             Style="{StaticResource CellText}"/></Border>

                    <!-- ─── 데이터 셀: 사출조건 온도 (Row 2) ─── -->
                    <Border Grid.Row="2" Grid.Column="2"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectTemp.Std1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="3"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectTemp.Val1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="4"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectTemp.Std2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="5"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectTemp.Val2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="6"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectTemp.Std3}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="7"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectTemp.Val3}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="8"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectTemp.Std4}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="9"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectTemp.Val4}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="10" Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectTemp.Std5}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="11" Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectTemp.Val5}" Style="{StaticResource CellText}"/></Border>

                    <!-- ─── 데이터 셀: 사출조건 빈 행 (Row 3) ─── -->
                    <Border Grid.Row="3" Grid.Column="2"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectEmpty.Std1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="3"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectEmpty.Val1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="4"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectEmpty.Std2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="5"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectEmpty.Val2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="6"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectEmpty.Std3}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="7"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectEmpty.Val3}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="8"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectEmpty.Std4}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="9"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectEmpty.Val4}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="10" Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectEmpty.Std5}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="11" Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectEmpty.Val5}" Style="{StaticResource CellText}"/></Border>

                    <!-- ─── 데이터 셀: 사출조건 압력 (Row 4) ─── -->
                    <Border Grid.Row="4" Grid.Column="2"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectPressure.Std1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="3"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectPressure.Val1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="4"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectPressure.Std2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="5"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectPressure.Val2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="6"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectPressure.Std3}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="7"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectPressure.Val3}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="8"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectPressure.Std4}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="9"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectPressure.Val4}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="10" Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectPressure.Std5}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="4" Grid.Column="11" Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectPressure.Val5}" Style="{StaticResource CellText}"/></Border>

                    <!-- ─── 데이터 셀: 사출조건 속도 (Row 5) ─── -->
                    <Border Grid.Row="5" Grid.Column="2"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectSpeed.Std1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="5" Grid.Column="3"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectSpeed.Val1}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="5" Grid.Column="4"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectSpeed.Std2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="5" Grid.Column="5"  Style="{StaticResource ValCell}"><TextBlock Text="{Binding RowInjectSpeed.Val2}" Style="{StaticResource CellText}"/></Border>
                    <Border Grid.Row="5" Grid.Column="6"  Style="{StaticResource StdCell}"><TextBlock Text="{Binding RowInjectSpeed.Std3}" Style="{StaticResource CellText}"/></Border>
