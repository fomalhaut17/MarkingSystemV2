#!/bin/bash
# 매 커밋 후 자동으로 patch 버전 +1 태그 생성.
# Skip 방법 (특수 케이스):
#   1) NO_BUMP=1 git commit ...
#   2) 커밋 메시지 마지막에 trailer 추가:  Skip-Bump: true
set -e

if [ "$NO_BUMP" = "1" ]; then
    echo "[hook] NO_BUMP=1 → 자동 태그 skip"
    exit 0
fi

if git log -1 --pretty=%B | git interpret-trailers --parse | grep -qiE '^Skip-Bump:[[:space:]]*(true|yes|1)[[:space:]]*$'; then
    echo "[hook] 커밋 trailer Skip-Bump 발견 → 자동 태그 skip"
    exit 0
fi

# Amend 커밋 감지: 같은 커밋에 이미 vX.Y.Z 태그가 있으면 skip (중복 방지)
HEAD_SHA=$(git rev-parse HEAD)
if git tag --points-at "$HEAD_SHA" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "[hook] HEAD에 이미 vX.Y.Z 태그 존재 → skip"
    exit 0
fi

# 가장 최근 vX.Y.Z 태그 찾기
LAST_TAG=$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)

if [ -z "$LAST_TAG" ]; then
    NEW_TAG="v0.1.0"
else
    VERSION="${LAST_TAG#v}"
    MAJOR=$(echo "$VERSION" | cut -d. -f1)
    MINOR=$(echo "$VERSION" | cut -d. -f2)
    PATCH=$(echo "$VERSION" | cut -d. -f3)
    NEW_PATCH=$((PATCH + 1))
    NEW_TAG="v${MAJOR}.${MINOR}.${NEW_PATCH}"
fi

git tag -a "$NEW_TAG" -m "Auto bump to $NEW_TAG"
echo "[hook] 자동 태그 생성: $NEW_TAG"
